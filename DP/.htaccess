Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not expose application internals from the web.
    RewriteRule ^(config|lib|storage|views)(/|$) - [F,L]
    RewriteRule ^schema\.sql$ - [F,L]

    # Let static assets be served directly and prevent rewriting an already
    # internally-routed /public request back into /public/public/... .
    RewriteRule ^assets/ - [L]
    RewriteRule ^public/ - [L]

    # Front-controller routing for /DP and friendly URLs such as /DP/login.
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>
